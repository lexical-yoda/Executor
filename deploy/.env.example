# Copy to .env next to compose.yaml. .env is git-ignored; keep it mode 600.

# Shared secret between the web and runner containers.
# Generate with: openssl rand -hex 32
RUNNER_TOKEN=

# Absolute host paths.
# This stack's directory (holds compose.yaml, .env and config/).
EXECUTOR_DIR=/srv/stacks/executor
# Run history (runs.jsonl). Created on first start.
EXECUTOR_DATA=/srv/appdata/executor/runner
# Parent of the stacks that actions may run compose against (mounted read-only
# into the runner at the same path). Point stacks_dir in actions.yaml at it to
# let stack discovery tell stopped stacks from deleted ones.
STACKS_DIR=/srv/stacks
# Map tiles live in $EXECUTOR_DIR/tiles (see README, "Map tiles").

EXECUTOR_PORT=1977
TZ=UTC

# Optional: a Beszel user with the "readonly" role, for machine stats.
BESZEL_EMAIL=
BESZEL_PASSWORD=

# Optional: a Jellyfin API key. The page warns about active streams before
# disruptive actions, and http steps can use it as ${JELLYFIN_API_KEY}.
JELLYFIN_API_KEY=

# Optional: the backups panel.
# Duplicati's UI password (Duplicati has no read-only login).
DUPLICATI_PASSWORD=
# A host folder mounted read-only into the runner at /watch, holding the
# folders listed under `files:` in actions.yaml (for backups that leave files
# in folders only root can read).
WATCH_DIR=

# Optional: media panels (Jellyseerr requests, Sonarr and Radarr queues,
# qBittorrent speeds). API keys are under Settings in each app.
JELLYSEERR_API_KEY=
SONARR_API_KEY=
RADARR_API_KEY=
QBITTORRENT_USERNAME=
QBITTORRENT_PASSWORD=

# Optional: S3 bucket size and growth in the backups panel. Use an IAM user
# whose only permission is cloudwatch:GetMetricStatistics; it cannot read,
# list or delete any data.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Optional but recommended: Executor's own history in one SQLite file (event
# log, service uptime, a year of hourly machine stats, media locations and
# plays for the weekly recap, each container's stack for discovery) plus the
# geolocation databases (about 130 MB). Create it owned by the web user:
#   sudo install -d -o 10001 -g 10001 -m 700 /srv/appdata/executor/web
EXECUTOR_WEB_DATA=

# Optional: a free MaxMind account (https://www.maxmind.com/en/geolite2/signup)
# for the GeoLite2 City database, used before DB-IP for media locations.
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=
